# Optional: defaults to .data/mode.sqlite. Use persistent storage for any hosted demo.
# SQLITE_PATH=.data/mode.sqlite

# Native Expo configuration (set in client/.env). This is public client
# configuration, so it must contain only a reachable API origin, never secrets.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Serve the staged Expo export at /; run npm run build:client first.
# Set this for both Next build and start. Legacy workflows remain at /legacy.
# MODE_EXPO_WEB=1

# Password for the seeded synthetic demo officer accounts (lead@, organizer@,
# treasurer@, volunteer@example.com). Set your own value before any shared demo.
# Required in production: a new database will not seed with the public default.
# MODE_DEMO_PASSWORD=mode-demo-2026

# Optional frozen clock (ISO 8601) for demonstrating expiry, reminders and
# deadlines deterministically. Leave unset for real time.
# MODE_DEMO_NOW=2026-10-10T08:00:00.000Z

# Optional comma-separated browser origins for development API access only.
# Exact HTTP(S) origins: no trailing slash, paths or wildcard. Ignored in production.
# Grants CORS for reads/bearer requests, not cookie CSRF exceptions or cross-origin login.
# Native clients omit browser Origin headers; Expo web uses same-origin cookie auth.
# MODE_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# PostgreSQL (docs/POSTGRESQL.md). When DATABASE_URL is set the application runs on
# PostgreSQL instead of the SQLite file: migrations, every module and every route, through
# the synchronous driver in src/lib/db/postgres-sync.ts. `npm run postgres:push` moves an
# existing SQLite database there first (uses psql when DATABASE_URL is set, otherwise the
# docker-compose service from `npm run postgres:up`).
# DATABASE_URL=postgres://mode:mode@127.0.0.1:5432/mode
# Receipt files when running on PostgreSQL (SQLite keeps them next to the database file).
# MODE_RECEIPTS_DIR=.data/receipts
# Host port for docker-compose.postgres.yml; change it when 5432 is reserved (common on Windows).
# MODE_POSTGRES_PORT=5432
# Run the whole test suite against a PostgreSQL server (files are serialised: npm run test:postgres).
# MODE_TEST_DATABASE_URL=postgres://mode:mode@127.0.0.1:5432/mode

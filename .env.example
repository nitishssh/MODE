# Optional: defaults to .data/mode.sqlite. Use persistent storage for any hosted demo.
# SQLITE_PATH=.data/mode.sqlite

# Comma-separated browser origins that may call /api from another origin during
# development. Keep empty for same-origin-only requests. Never use * when
# credentials are enabled.
# MODE_CORS_ORIGINS=http://192.168.1.50:8081,http://localhost:8081

# Reserved for an Expo client when one is added. This is public client
# configuration, so it must contain only a reachable API origin, never secrets.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Password for the seeded synthetic demo officer accounts (lead@, organizer@,
# treasurer@, volunteer@example.com). Set your own value before any shared demo.
# Required in production: a new database will not seed with the public default.
# MODE_DEMO_PASSWORD=mode-demo-2026

# Optional frozen clock (ISO 8601) for demonstrating expiry, reminders and
# deadlines deterministically. Leave unset for real time.
# MODE_DEMO_NOW=2026-10-10T08:00:00.000Z

# Optional comma-separated browser origins for development API access only.
# Exact HTTP(S) origins: no trailing slash, paths or wildcard. Ignored in production.
# Grants CORS for reads/bearer requests, not cookie CSRF exceptions or cross-origin login.
# Native clients omit browser Origin headers; Expo web uses same-origin cookie auth.
# MODE_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

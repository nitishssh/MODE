{
  "name": "mode-student-organization",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:lan": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "node client/node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "lint:client": "npm --prefix client run lint -- --max-warnings=0",
    "quality": "npm run lint && npm run lint:client && npm run typecheck && npm --prefix client run typecheck && npm run check:contracts && npm run check:client-contracts && npm run schema:check",
    "test:coverage": "node scripts/test-coverage.mjs",
    "audit:dependencies": "npm audit --package-lock-only --omit=dev --audit-level=high && npm --prefix client audit --package-lock-only --omit=dev --audit-level=high",
    "test": "tsx --import ./tests/setup-env.mjs --test tests/*.test.ts",
    "test:postgres": "tsx --import ./tests/setup-env.mjs --test --test-concurrency=1 tests/*.test.ts",
    "auth:setup": "node scripts/setup-auth.mjs",
    "test:foundation": "node scripts/check-foundation.mjs",
    "check:contracts": "tsx scripts/check-contract-docs.ts",
    "schema:dump": "tsx scripts/dump-schema.ts",
    "schema:check": "tsx scripts/dump-schema.ts --check",
    "postgres:export": "tsx scripts/export-postgres.ts",
    "postgres:push": "tsx scripts/export-postgres.ts --replace --push",
    "postgres:up": "docker compose -f docker-compose.postgres.yml up -d --wait",
    "postgres:down": "docker compose -f docker-compose.postgres.yml down",
    "db:purge": "tsx scripts/purge.ts",
    "club:init": "tsx scripts/init-club.ts",
    "club:import": "tsx scripts/import-members.ts",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "check:client-contracts": "node scripts/sync-contracts.mjs --check",
    "build:client": "npm run check:client-contracts && npm --prefix client run export:web && node scripts/stage-expo-web.mjs",
    "test:expo-web": "tsx scripts/check-expo-web.mjs",
    "check": "npm run check:version && npm run lint && npm run typecheck && npm run check:contracts && npm run schema:check && npm test && npm run build",
    "check:version": "node scripts/check-version.mjs",
    "check:all": "node scripts/check-all.mjs"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.5",
    "typescript": "~7.0.2"
  }
}
